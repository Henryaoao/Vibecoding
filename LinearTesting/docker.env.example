# Copy these values into .env for Docker Compose, or keep the generated
# local .env file created in this workspace.
#
# Compose automatically reads .env when you run:
# docker compose up --build

COMPOSE_PROJECT_NAME=aoa_auth_mvp

APP_ENV=development
BACKEND_CONTAINER_NAME=aoa_auth_backend
BACKEND_HOST_PORT=8080
BACKEND_CONTAINER_PORT=8080
AUTH_TOKEN_SECRET=local-dev-auth-token-secret-change-before-production

FRONTEND_CONTAINER_NAME=aoa_auth_frontend
FRONTEND_HOST_PORT=5173

MYSQL_IMAGE=mysql:8.4
MYSQL_CONTAINER_NAME=aoa_auth_mysql
MYSQL_HOST_PORT=3306
MYSQL_DATABASE=auth_mvp
MYSQL_USER=auth_user
MYSQL_PASSWORD=auth_password
MYSQL_ROOT_PASSWORD=root_password

DATABASE_URL=auth_user:auth_password@tcp(mysql:3306)/auth_mvp?parseTime=true&charset=utf8mb4&collation=utf8mb4_unicode_ci

PHPMYADMIN_IMAGE=phpmyadmin:5.2
PHPMYADMIN_CONTAINER_NAME=aoa_auth_phpmyadmin
PHPMYADMIN_HOST_PORT=8081
