{
  "expo": {
    "name": "ProjectM Mobile",
    "slug": "projectm-mobile",
    "scheme": "projectm",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.projectm.mobile",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.projectm.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#F7F9F6"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow ProjectM Mobile to access Face ID for secure sign-in."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "mock"
    }
  }
}
