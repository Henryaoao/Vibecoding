COMPOSE_PROJECT_NAME=projectm

# Railway / production database URL.
# Paste the value from Railway Postgres > Connect > DATABASE_URL into local .env only.
DATABASE_URL=postgresql://postgres:CHANGE_ME@HOST:PORT/railway

# Local Docker database URL.
LOCAL_DATABASE_URL=postgres://projectm_user:projectm_password@localhost:5432/projectm?sslmode=disable
COMPOSE_DATABASE_URL=postgres://projectm_user:projectm_password@postgres:5432/projectm?sslmode=disable
APP_DATABASE_URL=postgres://projectm_user:projectm_password@postgres:5432/projectm?sslmode=disable
FRONTEND_URL=http://localhost:3000/

# Backend auth/session settings. Replace this in local .env; keep committed examples as placeholders only.
SESSION_SECRET=replace-with-local-session-secret

# Microsoft Teams / Entra ID SSO local placeholders. Register a Web app and add
# the redirect URI below, then paste real credentials into local .env only.
TEAMS_CLIENT_ID=replace-with-teams-client-id
TEAMS_CLIENT_SECRET=replace-with-teams-client-secret
TEAMS_TENANT_ID=common
TEAMS_REDIRECT_URI=http://localhost:8080/api/v1/auth/teams/callback
TEAMS_AUTH_URL=https://login.microsoftonline.com/common/oauth2/v2.0/authorize
TEAMS_TOKEN_URL=https://login.microsoftonline.com/common/oauth2/v2.0/token
TEAMS_USERINFO_URL=https://graph.microsoft.com/oidc/userinfo
TEAMS_SCOPES=openid profile email

FRONTEND_CONTAINER_NAME=projectm_frontend
FRONTEND_HOST_PORT=3000
BACKEND_CONTAINER_NAME=projectm_backend
BACKEND_HOST_PORT=8080

POSTGRES_IMAGE=postgres:16
POSTGRES_CONTAINER_NAME=projectm_postgres
POSTGRES_HOST_PORT=5432
POSTGRES_DB=projectm
POSTGRES_USER=projectm_user
POSTGRES_PASSWORD=projectm_password

PGADMIN_IMAGE=dpage/pgadmin4:8
PGADMIN_CONTAINER_NAME=projectm_pgadmin
PGADMIN_HOST_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@projectm.test
PGADMIN_DEFAULT_PASSWORD=pgadmin_password
